# Copy to .dev.vars (gitignored). Read by `npm run dev:api` / `npm run preview` (wrangler pages dev).
# Primary reader: Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# optional: replaces the first Gemini model
GEMINI_MODEL=
# Backups (optional, free, no card): OpenRouter and Groq. Workers AI needs no key (AI binding in wrangler.toml; `wrangler login` once).
OPENROUTER_API_KEY=
GROQ_API_KEY=
# Only for scripts/spike-providers.ts (Workers AI over REST):
CF_ACCOUNT_ID=
CF_API_TOKEN=
